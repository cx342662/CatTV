 function push() {
     doAction('push', { url: $('#push_url').val() });
+}
+
+async function saveMdblist(event) {
+    event.preventDefault();
+    const field = document.getElementById('mdblist-key');
+    const status = document.getElementById('mdblist-status');
+    const button = event.currentTarget.querySelector('button');
+    const key = field.value.trim();
+    if (!key) {
+        status.textContent = '请输入 MDBList API Key';
+        return;
+    }
+    button.disabled = true;
+    status.textContent = '正在保存…';
+    try {
+        const response = await fetch('/action', {
+            method: 'POST',
+            headers: { 'X-CatTV-Settings': 'mdblist' },
+            body: new URLSearchParams({ do: 'mdblist', key })
+        });
+        if (!response.ok || (await response.text()).trim() !== 'SAVED') {
+            status.textContent = '电视未能保存，请检查 Key 后重试';
+            return;
+        }
+        field.value = '';
+        status.textContent = '已保存到电视，重新聚焦海报或打开影片详情查看评分';
+    } catch {
+        status.textContent = '无法连接电视，请检查手机与电视是否在同一网络';
+    } finally {
+        button.disabled = false;
+    }
 }
 
